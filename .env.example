# Required for real runs. Without it the app runs a simulated swarm.
CEREBRAS_API_KEY=
# Model id on Cerebras. Check your Cerebras console if this differs.
CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial
# Backup model. Used only when the main model is refused (404). Use off to disable.
CEREBRAS_FALLBACK_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# low saves credits. Default is low. Use off to not send it at all.
CEREBRAS_REASONING_EFFORT=low
# Hard limits. The credit saver in the dashboard stays under these.
TOKEN_BUDGET_MAX=400000
# Max agents working at once
SWARM_MAX_WORKERS=12
# Max files pulled from a repo
SWARM_MAX_FILES=60
# GitHub sign in (OAuth App). Create one at github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random text. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: only needed if you skip GitHub sign in and still want higher read limits
GITHUB_TOKEN=

# OpenClaw harness (hackathon rule). When set, every agent call goes through OpenClaw.
# See openclaw/SETUP.md
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_AGENT=openclaw/default
# Key for the OpenClaw skill to call /api/reborn
REBORN_API_KEY=
